<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.civilization.buzz-seat-clerk</string>

  <key>ProgramArguments</key>
  <array>
    <!-- SINGLE-SEAT TEMPLATE, not a deployable artifact as-is: `/usr/local/bin/clerk` is a
         placeholder, not a real path this repo ever installs to. Replace it with wherever your
         `cargo build --release -p buzz-seat-clerk --bin clerk` (or scripts/install-clerk.sh)
         actually put the binary -- e.g. `target/release/clerk`, or `~/.local/agencyos/bin/clerk`
         if you used install-clerk.sh. For running SEVERAL seats' clerks (one launchd job per
         seat, since each carries its own identity), use scripts/generate-clerk-launchd.sh
         instead of hand-editing this file -- it generates one correct plist + wrapper per seat
         from a fleet registry. -->
    <string>REPLACE_WITH_YOUR_INSTALLED_CLERK_PATH</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- Set SEAT_NSEC and RELAY_URL in a launchd-managed secrets file or
         via `launchctl setenv` before loading this plist. Never store nsec
         in plaintext in this file. -->
    <key>SEAT_NSEC</key>
    <string>REPLACE_WITH_BECH32_NSEC</string>
    <key>RELAY_URL</key>
    <string>ws://localhost:3000</string>
    <key>WAKE_FILE</key>
    <string>/tmp/buzz-seat-clerk.wake</string>
    <key>RUST_LOG</key>
    <string>info</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <!-- Watch the wake file: when it changes, a supervisor script or launchd
       WatchPaths agent can fire to wake the seat terminal. -->
  <key>StandardOutPath</key>
  <string>/tmp/buzz-seat-clerk.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/buzz-seat-clerk.stderr.log</string>
</dict>
</plist>
